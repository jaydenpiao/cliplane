DATABASE_URL=postgres://cliplane:cliplane_local@127.0.0.1:54329/cliplane
APP_ORIGIN=http://localhost:3000
API_PORT=4000
DATA_DIR=./data
# Local-only sample workspace and synthetic footage. Set to 0 on any shared host.
DEMO_ENABLED=1
MAX_UPLOAD_BYTES=2147483648
MEDIA_TIMEOUT_SECONDS=1800
RAW_RETENTION_DAYS=7
# Required behind production HTTPS. No secrets or signed media URLs in logs.
COOKIE_SECURE=0
